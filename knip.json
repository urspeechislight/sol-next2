{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".github/**"],
  "ignoreBinaries": ["uv"],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "workspaces": {
    "frontend": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
