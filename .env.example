# Backend (Pydantic Settings reads SOL_*).
SOL_LOG_LEVEL=INFO

# Origins allowed to call the backend cross-origin. The Vite dev proxy makes
# browser→API same-origin for the app itself, so these matter only for direct
# :8001 access (curl, scripts, a frontend served from another host). Add one
# entry per scheme+host you hit the API from directly.
SOL_CORS_ALLOWED_ORIGINS=["http://localhost:8765","http://127.0.0.1:8765"]

# Required. Absolute path to the read-only corpus root (frontmatter JSON files).
SOL_BOOKS_DIR=/absolute/path/to/your/corpus/books

# Opt-in developer inspection surface (/api/dev/*). Unset or false: the routes
# are not registered and requests to them 404.
# SOL_DEV_TOOLS=true

# Base URL of the consolidated search backend (HTTP; it owns the Postgres +
# FTS page index) proxied by /api/search. Unset: the default below points at a
# co-located instance.
# SOL_CORPUS_SEARCH_BASE_URL=http://127.0.0.1:8123

# Path to the ported sol-next pipeline config. Unset: config/sol.yaml in this
# repo. Absolute paths only.
# SOL_PIPELINE_CONFIG=/absolute/path/to/config/sol.yaml

# Frontend dev only (vite.config.ts): target for the /api proxy when a session
# worktree runs its own backend. Unset, the proxy goes to :8001.
# SOL_API_TARGET=http://localhost:8010

# LLM retrieval planner behind /api/search/semantic (Anthropic-messages
# protocol). Unset key: the route answers 503 naming this setting. Base URL
# and model defaults target Z.ai's GLM endpoint.
# SOL_LLM_API_KEY=your-key
# SOL_LLM_BASE_URL=https://api.z.ai/api/anthropic
# SOL_LLM_MODEL=glm-5.3

# Read-only Postgres DSN of sol-next3's narrator store — the extraction source
# for scripts/build_registry.py. Unset: the build requires an explicit --pg-dsn
# and aborts loudly without either.
# SOL_RIJAL_PG_DSN=postgresql://user:pass@host:5432/sol_next3
