# Backend (Pydantic Settings reads SOL_*).
SOL_LOG_LEVEL=INFO

# Origins allowed to call the backend cross-origin. The Vite dev proxy makes
# browser→API same-origin for the app itself, so these matter only for direct
# :8001 access (curl, scripts, a frontend served from another host). Add one
# entry per scheme+host you hit the API from directly.
SOL_CORS_ALLOWED_ORIGINS=["http://localhost:8765","http://127.0.0.1:8765"]

# Required. Absolute path to the read-only corpus root (frontmatter JSON files).
SOL_BOOKS_DIR=/absolute/path/to/your/corpus/books

# Opt-in developer inspection surface (/api/dev/*). Unset or false: the routes
# are not registered and requests to them 404.
# SOL_DEV_TOOLS=true

# Base URL of the consolidated search backend (Postgres + FTS) proxied by
# /api/search and /api/quran/search. Required for search; unset disables it.
# SOL_CORPUS_SEARCH_BASE_URL=postgresql+psycopg://user:pass@host/db

# Frontend dev only (vite.config.ts): target for the /api proxy when a session
# worktree runs its own backend. Unset, the proxy goes to :8001.
# SOL_API_TARGET=http://localhost:8010
